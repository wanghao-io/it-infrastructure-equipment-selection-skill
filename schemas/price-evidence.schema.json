{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wanghao-io/it-infrastructure-equipment-selection-skill/schemas/price-evidence.schema.json",
  "title": "Price evidence collection",
  "type": "object",
  "required": ["schema_version", "items"],
  "properties": {"schema_version": {"const": 1}, "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}},
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["candidate", "product_class", "configuration", "source_type", "source_date", "as_of_date", "quote_current", "currency", "comparable"],
      "properties": {
        "candidate": {"type": "string", "minLength": 1},
        "product_class": {"enum": ["configurable-enterprise", "fixed-sku", "commodity-component"]},
        "configuration": {"type": ["string", "object"]},
        "source_type": {"type": "string", "minLength": 1},
        "quote_mode": {"type": "string"},
        "source": {"type": "string"},
        "source_date": {"type": "string", "format": "date"},
        "as_of_date": {"type": "string", "format": "date"},
        "quote_current": {"type": "boolean"},
        "technical_fit_status": {"enum": ["PASS", "CONDITIONAL", "FAIL"]},
        "eligible_for_pricing": {"type": "boolean"},
        "orderability_confirmed": {"type": "boolean"},
        "price_scope_complete": {"type": "boolean"},
        "starting_price_or_base_config": {"type": "boolean"},
        "used_or_refurbished": {"type": "boolean"},
        "price": {"$ref": "#/$defs/cost"},
        "hardware_price": {"$ref": "#/$defs/cost"},
        "mandatory_accessories": {"$ref": "#/$defs/cost"},
        "required_licenses": {"$ref": "#/$defs/cost"},
        "warranty_support": {"$ref": "#/$defs/cost"},
        "required_implementation": {"$ref": "#/$defs/cost"},
        "tax_amount": {"$ref": "#/$defs/cost"},
        "shipping": {"$ref": "#/$defs/cost"},
        "currency": {"type": "string", "pattern": "^[A-Za-z]{3}$"},
        "tax_included": {"type": "boolean"},
        "warranty": {"type": "string"},
        "configuration_match": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
        "configuration_match_score": {"type": "number", "minimum": 0, "maximum": 1},
        "exact_configuration_match": {"type": "boolean"},
        "comparable": {"type": "boolean"},
        "evidence_level": {"enum": ["Verified", "Market-verified", "Comparable-transaction", "Estimated", "Needs confirmation"]},
        "notes": {"type": "string"},
        "quote_id": {"type": "string"},
        "supplier": {"type": "string"},
        "sales_channel": {"type": "string"},
        "quote_valid_until": {"type": "string", "format": "date"}
      },
      "additionalProperties": false,
      "anyOf": [{"required": ["price"]}, {"required": ["hardware_price"]}]
    },
    "cost": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "string", "enum": ["TBD", "Needs confirmation", "待确认"]}]}
  }
}
